# deps
node_modules/
.pnpm-store/

# build
dist/
build/
.turbo/
*.tsbuildinfo
.next/

# Expo / RN
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Generated by `expo prebuild` (continuous native generation). The
# source of truth is apps/mobile/app.json + the plugin list there.
apps/mobile/ios/
apps/mobile/android/
ios/Pods/
ios/build/
android/build/
android/app/build/
android/.gradle/

# env — every variant (.env.production, .env.live, …), except the examples
.env
.env.*
!.env.example

# keys, certificates and service credentials (Wallet pass certs are PEMs)
*.pem
*.cer
*.pkpass
google-services.json
GoogleService-Info.plist
*credentials*.json
*service-account*.json

# database dumps — backups live in the private ludi-backups repo, never here
*.dump
*.dump.enc
*.sql.gz

# local caches (fonts fetched for print builds, etc.)
.cache/

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Supabase CLI runtime state — regenerated on every `supabase start`/`db reset`
**/supabase/.branches/
**/supabase/.temp/

# Claude Code session state — per-worktree, not source-of-truth
.claude/
.vercel

# venue agreement PDFs carry personal data
docs/legal/venue-agreement/out/
docs/legal/venue-agreement/intake/

# research report builds (LaTeX out/ folders next to each report.tex)
docs/plans/*/out/
