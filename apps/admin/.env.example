# Placeholders are deliberately NOT key-shaped. A value like `sk_test_...` or
# `your-anon-key` fails twice over: secret scanners pattern-match the real
# prefixes and raise false positives on this file, and — worse — the string
# looks enough like a value to be pasted as one. On 2026-08-22 both
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET were set on the production
# project to the literal text below, and the CLI reported success both times.
# REPLACE_ME_* cannot be mistaken for a credential by a human or a scanner.

# Public — safe to expose in the bundle. Still not committed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_key

# ─── M4 #23 Sentry (ADR-0010) ───────────────────────────────────────────────
# Public DSN for the `ludi-admin` Sentry project. Leave unset to keep Sentry
# dormant (init is gated on `enabled`). environment tags events.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Source-map upload at build time needs (CI/build env, NOT committed):
# SENTRY_ORG, SENTRY_PROJECT=ludi-admin, SENTRY_AUTH_TOKEN.

# ─── Pointing admin at the hosted project ───────────────────────────────────
# `.env.local` stays on the LOCAL Supabase stack, because that is what venue
# and schedule work should be developed against — the schedule editor writes
# rows that decide real availability, and you do not want that pointed at
# production while iterating.
#
# To read production instead, put the hosted values in `.env.prod.local`
# (gitignored by the .env.*.local rule) and run:
#
#     pnpm admin dev:prod
#
# That exports the file into the environment before starting Next, and Next
# does not override variables already present in process.env — so it wins
# over .env.local without either file being edited or swapped.
#
# NOTE: reading production needs more than the right URL. The admin surface
# is gated on `users.role = 'admin'`, and a fresh project has no admin —
# every user signs up as `player`. Promotion is blocked by
# `tg_users_block_role_change` even for a superuser; see JOURNAL.md for the
# `SET LOCAL session_replication_role = 'replica'` wrapper that gets round it.
