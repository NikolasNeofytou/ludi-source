# Placeholders are deliberately NOT key-shaped. A value like `sk_test_...` or
# `your-anon-key` fails twice over: secret scanners pattern-match the real
# prefixes and raise false positives on this file, and — worse — the string
# looks enough like a value to be pasted as one. On 2026-08-22 both
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET were set on the production
# project to the literal text below, and the CLI reported success both times.
# REPLACE_ME_* cannot be mistaken for a credential by a human or a scanner.

# Public — safe to expose in the app bundle. Still not committed.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_key
# Stripe publishable key (test mode for dev, live mode for prod). The
# matching secret key lives in Supabase Edge Function env, NOT here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME_stripe_publishable_key

# ─── M4 #23 Sentry (ADR-0010) ───────────────────────────────────────────────
# Public DSN for the `ludi-mobile` Sentry project. Safe in the bundle.
# Leave unset to disable Sentry entirely (init no-ops). environment tags the
# events: development / staging / production.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Source-map upload at EAS build time needs (CI/build env, NOT committed):
# SENTRY_ORG, SENTRY_PROJECT=ludi-mobile, SENTRY_AUTH_TOKEN.
# IMPORTANT: the @sentry/react-native build phase runs sentry-cli on every
# native build and HARD-FAILS if it has no org/token. For local/dev builds
# without an auth token, set this so the build skips the upload step:
SENTRY_DISABLE_AUTO_UPLOAD=true

# ─── M4 #24 PostHog product analytics (ADR-0011) ────────────────────────────
# Public project API key for the `ludi` PostHog project (EU cloud). Safe in
# the bundle. Leave unset to disable analytics entirely (the module no-ops:
# no init, no events). Even WITH a key it is consent-gated — nothing sends
# until the user accepts the GDPR modal, and it stops on revocation.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── M4 #20 Auth fan-out ────────────────────────────────────────────────────
# Google OAuth client IDs — create at console.cloud.google.com →
# APIs & Services → Credentials. You need three separate OAuth 2.0
# client IDs in the same project: iOS, Android, and Web.
# - iOS:     bundleId = com.ludi.app
# - Android: package  = com.ludi.app, SHA-1 from your debug & release keystores
# - Web:     used by Supabase server-side to verify the ID token
# Supabase dashboard → Authentication → Providers → Google: paste the WEB
# client ID + Web client secret. Leave these three EXPO_PUBLIC_* vars unset
# locally to disable the Google button at runtime instead of crashing.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Apple Sign-In needs no client-side env vars — the iOS device handles
# everything via the Sign in with Apple capability (set in app.json).
# Server-side, Supabase dashboard → Authentication → Providers → Apple
# needs: Service ID, Team ID, Key ID, P8 private key.
# The button is auto-hidden on Android and on iOS devices that report
# AppleAuthentication.isAvailableAsync() === false.

# Magic-link works out of the box against the Supabase project above — no
# extra env vars. Make sure the project's auth redirect URL allowlist
# includes `ludi://auth/callback` (Supabase dashboard → Authentication →
# URL Configuration → Additional Redirect URLs).

# Android Google Maps (home mini-map). Restricted key from Cloud project
# ludi-507117 — injected into android.config.googleMaps by app.config.js.
# Lives in EAS env (production environment) for cloud builds.
GOOGLE_MAPS_ANDROID_API_KEY=
