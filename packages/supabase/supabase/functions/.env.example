# Placeholders are deliberately NOT key-shaped. A value like `sk_test_...` or
# `your-anon-key` fails twice over: secret scanners pattern-match the real
# prefixes and raise false positives on this file, and — worse — the string
# looks enough like a value to be pasted as one. On 2026-08-22 both
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET were set on the production
# project to the literal text below, and the CLI reported success both times.
# REPLACE_ME_* cannot be mistaken for a credential by a human or a scanner.

# Copy to `.env.local` and fill in. Never commit the filled-in file.
# Local Supabase (from `supabase start` output):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode — use keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=REPLACE_ME_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_stripe_publishable_key

# Stripe webhook signing secret. In local dev this comes from
# `stripe listen --forward-to http://127.0.0.1:54321/functions/v1/stripe-webhook`
# — it prints a `whsec_...` value which is valid only while that command runs.
# In production it comes from the webhook endpoint settings in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=REPLACE_ME_stripe_webhook_signing_secret

# Signing secret of the SECOND Stripe destination — the one listening to
# connected-account events (payout.paid/failed, account.updated) at the same
# URL. Optional: without it, only the platform destination verifies. Local
# dev doesn't need it (`stripe listen` is a single endpoint).
STRIPE_CONNECT_WEBHOOK_SECRET=REPLACE_ME_stripe_connect_webhook_signing_secret
EXPIRE_COLLECTING_SECRET=REPLACE_ME_random_shared_secret_for_the_sweeper

# The admin site. invite-venue-owner puts it in the invite email, and
# venue-connect-onboard accepts Stripe return URLs only on its origin.
# Local dev: http://localhost:3001 (the admin dev server).
ADMIN_SITE_URL=https://ludi-admin.vercel.app

# Sign in with Apple token revocation on account deletion (anonymize-me,
# App Review 5.1.1(v)). From Apple Developer → Keys: a key with "Sign in
# with Apple" enabled, tied to the app's primary App ID. The .p8 is shown
# ONCE at creation. APPLE_SIWA_PRIVATE_KEY is the whole PEM; literal \n
# escapes are accepted. APPLE_TEAM_ID is shared with the wallet-pass
# function. APPLE_SIWA_CLIENT_ID defaults to the bundle id. Unset = the
# revoke is skipped (logged + recorded in the audit row), never a failure.
APPLE_SIWA_KEY_ID=REPLACE_ME_ten_char_key_id
APPLE_SIWA_PRIVATE_KEY=REPLACE_ME_p8_pem_contents
APPLE_TEAM_ID=REPLACE_ME_ten_char_team_id
