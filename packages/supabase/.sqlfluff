[sqlfluff]
# Lint configuration for the migrations + tests under packages/supabase.
# Enforces only what docs/CONVENTIONS.md §Database — migrations commits
# to today:
#   CP01  uppercase keywords
#   CP02  lowercase unquoted identifiers
#   CP04  uppercase NULL / TRUE / FALSE literals
#   CP05  lowercase data-type names (uuid, text, int, …)
#
# Everything else (line length, alignment spacing, alias style, indent
# inside dollar-quoted function bodies, snake_case columns) is *not*
# committed by CONVENTIONS.md, so the allowlist stays narrow. Re-enable
# rules only after adding them to CONVENTIONS.md first — the doc-first
# rule prevents lint surprises in a PR otherwise unrelated to style.
dialect = postgres
templater = raw

# Lint every byte; default skip is 20000 and the initial schema is 21k.
large_file_skip_byte_limit = 0

# Explicit allowlist. Everything not listed here is silently OK.
rules = CP01, CP02, CP04, CP05

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
