# Expo + Metro assume flat node_modules (npm/yarn layout).
# pnpm's default (nested symlinks) breaks transitive imports like
# @babel/runtime helpers and whatwg-fetch that RN internals expect.
# Official Expo recommendation for pnpm monorepos: use the hoisted linker.
# https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# Keep the symlinked workspace protocol so packages/ui resolves live.
prefer-workspace-packages=true

# Strict peer dependencies would flood warnings with no-ops for our case;
# we still see them but they don't block installs.
strict-peer-dependencies=false
